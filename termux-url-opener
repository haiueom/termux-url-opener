#!/usr/bin/env bash

# --- Configuration ---
DOWNLOAD_DIR="$HOME/storage/downloads/termux"
UPDATER_URL="https://raw.githubusercontent.com/haiueom/termux-url-opener/main/update.sh"

# Ensure download directory exists
mkdir -p "$DOWNLOAD_DIR"

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_message() {
    case "$1" in
        INFO)    echo -e "${BLUE} [*] $2${NC}" ;;
        SUCCESS) echo -e "${GREEN} [✓] $2${NC}" ;;
        ERROR)   echo -e "${RED} [!] $2${NC}" >&2 ;;
        WARN)    echo -e "${YELLOW} [?] $2${NC}" ;;
    esac
}

print_header() {
    clear
    local bar="========================================="
    echo -e "${BLUE}${bar}${NC}"
    echo -e "${GREEN} [#] Termux URL Downloader${NC}"
    echo -e "${GREEN} [#] Script by: haiueom${NC}"
    echo -e "${BLUE}${bar}${NC}"
}

choose_video_format() {
    local option
    local format

    while true; do
        echo -e "${BLUE}-----------------------------------------${NC}" >&2
        echo " Select video resolution:" >&2
        echo " [1] Best available" >&2
        echo " [2] 1080p (FHD)" >&2
        echo " [3] 720p (HD)" >&2
        echo " [4] 480p (SD)" >&2
        echo " [5] 360p (LD)" >&2
        echo " [6] Custom" >&2
        echo -e "${BLUE}-----------------------------------------${NC}" >&2
        read -rp "$(echo -e "${YELLOW}Choose a resolution option: ${NC}")" option

        case $option in
            1)
                format="bv*+ba/b"
                ;;
            2)
                format="bv*[height<=1080]+ba/b[height<=1080]"
                ;;
            3)
                format="bv*[height<=720]+ba/b[height<=720]"
                ;;
            4)
                format="bv*[height<=480]+ba/b[height<=480]"
                ;;
            5)
                format="bv*[height<=360]+ba/b[height<=360]"
                ;;
            6)
                read -rp "$(echo -e "${YELLOW}Enter max height (e.g. 720) or a yt-dlp format string: ${NC}")" option
                if [[ "$option" =~ ^[0-9]+$ ]]; then
                    format="bv*[height<=${option}]+ba/b[height<=${option}]"
                else
                    format="$option"
                fi
                ;;
            *)
                log_message ERROR "Invalid resolution option '$option'. Please try again."
                continue
                ;;
        esac

        echo "$format"
        return 0
    done
}

# --- Download Functions ---
download_mp4_ytdlp() {
    local url="$1"
    local format
    format=$(choose_video_format)
    if [ -z "$format" ]; then
        log_message ERROR "No video format selected."
        return 1
    fi

    local target_dir="${DOWNLOAD_DIR}/ytdlp_video"
    mkdir -p "$target_dir"
    log_message INFO "Downloading MP4 video to: $target_dir"
    yt-dlp -f "$format" -t mp4 --output "$target_dir/%(title)s.%(ext)s" "$url"
}

download_mkv_ytdlp() {
    local url="$1"
    local format
    format=$(choose_video_format)
    if [ -z "$format" ]; then
        log_message ERROR "No video format selected."
        return 1
    fi

    local target_dir="${DOWNLOAD_DIR}/ytdlp_video"
    mkdir -p "$target_dir"
    log_message INFO "Downloading MKV video to: $target_dir"
    yt-dlp -f "$format" -t mkv --output "$target_dir/%(title)s.%(ext)s" "$url"
}

download_mp3_ytdlp() {
    local url="$1"
    local target_dir="${DOWNLOAD_DIR}/ytdlp_audio"
    mkdir -p "$target_dir"
    log_message INFO "Downloading MP3 audio to: $target_dir"
    yt-dlp -t mp3 --audio-quality 0 --output "$target_dir/%(title)s.%(ext)s" "$url"
}

download_aac_ytdlp() {
    local url="$1"
    local target_dir="${DOWNLOAD_DIR}/ytdlp_audio"
    mkdir -p "$target_dir"
    log_message INFO "Downloading AAC audio to: $target_dir"
    yt-dlp -t aac --audio-quality 0 --output "$target_dir/%(title)s.%(ext)s" "$url"
}

download_mp3_spotdl() {
    local url="$1"
    local target_dir="${DOWNLOAD_DIR}/spotdl"
    mkdir -p "$target_dir"
    log_message INFO "Downloading from Spotify to: $target_dir"
    spotdl download "$url" --output "$target_dir"
}

download_curl() {
    local url="$1"
    local target_dir="${DOWNLOAD_DIR}/curl"
    mkdir -p "$target_dir"
    log_message INFO "Downloading with curl to: $target_dir"
    (cd "$target_dir" && curl -fO -L --remote-header-name "$url")
}

download_wget() {
    local url="$1"
    local target_dir="${DOWNLOAD_DIR}/wget"
    mkdir -p "$target_dir"
    log_message INFO "Downloading with wget to: $target_dir"
    wget --content-disposition -P "$target_dir" "$url"
}

url="$1"

if [ -z "$url" ]; then
    print_header
    read -rp "$(echo -e "${YELLOW}Enter the URL to download: ${NC}")" url
    if [ -z "$url" ]; then
        log_message ERROR "No URL provided. Exiting."
        exit 1
    fi
fi

while true; do
    print_header
    log_message INFO "Target URL: ${url}"
    echo -e "${BLUE}-----------------------------------------${NC}"
    echo " [1] Download mp4  (yt-dlp)"
    echo " [2] Download mkv  (yt-dlp)"
    echo " [3] Download mp3  (yt-dlp)"
    echo " [4] Download aac  (yt-dlp)"
    echo " [5] Download mp3  (spotdl)"
    echo " [6] Download file (curl)"
    echo " [7] Download file (wget)"
    echo -e " [${RED}x${NC}] Exit"
    echo -e "${BLUE}-----------------------------------------${NC}"

    read -rp "$(echo -e "${YELLOW}Choose an option: ${NC}")" option
    echo

    case $option in
        1) download_mp4_ytdlp "$url" ;;
        2) download_mkv_ytdlp "$url" ;;
        3) download_mp3_ytdlp "$url" ;;
        4) download_aac_ytdlp "$url" ;;
        5) download_mp3_spotdl "$url" ;;
        6) download_curl "$url" ;;
        7) download_wget "$url" ;;
        x|X)
            log_message INFO "Goodbye!"
            break
            ;;
        *)
            log_message ERROR "Invalid option '$option'."
            ;;
    esac

    echo
    log_message SUCCESS "Operation completed."
    read -n 1 -s -r -p "Press any key to return to the menu..."
done
